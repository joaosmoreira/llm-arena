// Prisma schema file for LLM Arena

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String?
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  threads   Thread[]
  votes     Vote[]

  @@index([clerkId])
}

model Thread {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New Arena Battle")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  turns     Turn[]

  @@index([userId])
}

model Turn {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  prompt    String   @db.Text
  createdAt DateTime @default(now())

  responses ModelResponse[]
  vote      Vote?

  @@index([threadId, createdAt])
}

enum ResponseStatus {
  STREAMING
  COMPLETED
  FAILED
}

model ModelResponse {
  id                 String         @id @default(cuid())
  turnId             String
  turn               Turn           @relation(fields: [turnId], references: [id], onDelete: Cascade)
  modelId            String
  modelName          String
  text               String         @db.Text
  status             ResponseStatus @default(COMPLETED)
  timeToFirstTokenMs Int?
  tokensPerSecond    Float?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  costUsd            Float?         @default(0.0)
  errorMessage       String?        @db.Text
  createdAt          DateTime       @default(now())

  votes              Vote[]

  @@unique([turnId, modelId])
  @@index([modelId])
}

model Vote {
  id              String        @id @default(cuid())
  turnId          String        @unique
  turn            Turn          @relation(fields: [turnId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelResponseId String
  modelResponse   ModelResponse @relation(fields: [modelResponseId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([userId])
}
